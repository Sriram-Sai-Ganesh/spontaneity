{
  "name": "chat-template",
  "private": true,
  "author": "Ali Madooei",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "concurrently --names backend,frontend -c blue,green \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "npx convex dev",
    "dev:frontend": "vite",
    "build": "vite build",
    "postbuild": "cp dist/index.html dist/404.html",
    "format": "prettier --write .",
    "lint": "eslint --fix .",
    "type-check": "tsc -p tsconfig.app.json --noEmit 2>&1 | grep -E '^src/' || true && tsc -p convex/tsconfig.json --noEmit",
    "type-check:src": "tsc -p tsconfig.app.json --noEmit 2>&1 | grep -E '^src/' || true",
    "type-check:convex": "tsc -p convex/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:convex": "vitest run --project convex",
    "test:frontend": "vitest run --project frontend",
    "test:iteration2": "node scripts/test-iteration2.mjs",
    "test:iteration3": "node scripts/test-iteration3.mjs",
    "test:team": "node scripts/test-iteration3.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "validate": "pnpm run type-check && pnpm run lint && pnpm run test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@auth/core": "^0.37.4",
    "@convex-dev/auth": "^0.0.90",
    "@hono/zod-validator": "^0.7.6",
    "@legendapp/state": "^2.1.15",
    "@openrouter/ai-sdk-provider": "^2.2.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "ai": "^6.0.86",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.32.0",
    "convex-helpers": "^0.1.112",
    "crypto": "^1.0.1",
    "crypto-js": "^4.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "hono": "^4.11.10",
    "jose": "^6.1.3",
    "lucide-react": "^0.563.0",
    "marked": "^17.0.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.10.0",
    "shiki": "^3.22.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "use-stick-to-bottom": "^1.1.3",
    "wouter": "^3.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/ui": "4.0.18",
    "concurrently": "^9.2.1",
    "convex-test": "^0.0.41",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "prettier": "3.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "4.0.18"
  }
}
